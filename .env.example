# Copy to .env (gitignored) and fill in.
#
# Only used by scripts/movie-seed/enrich_movie_seed.py, which runs offline on
# your machine to add posters and synopses to the committed catalogue. The app
# itself never reads this — it ships the generated JSON.
#
# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
